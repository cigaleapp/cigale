# Exclude everything by default
*

# Re-include the protocols-server source
!protocols-server/
!protocols-server/*.ts
!protocols-server/package.json

# Re-include the example protocol JSONs (imported at runtime by insects.ts/irit.ts)
!examples/
!examples/*.cigaleprotocol.json

# Re-include the protocol schema (used to generate protocol-types.ts at build time)
!static/*.schema.json

# Re-include the protocol YAML manifests (served at the root level by the server).
# Only the YAML sources are baked in — the .cigaleprotocol.json manifests are
# generated at runtime by the metadatabuilders and written next to the YAMLs.
!protocols/
!protocols/*.yaml
!protocols/bases/
!protocols/bases/*.yaml
protocols/*.json
protocols/bases/*.json
