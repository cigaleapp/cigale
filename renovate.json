{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>gwennlbh/renovate"],
	"prConcurrentLimit": 8,
	"gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
	"customManagers": [
		{
			"customType": "regex",
			"description": "Update Caddy images in the inline Dockerfile",
			"managerFilePatterns": [
				"/^\\.github\\/workflows\\/dev-deployments-server-image\\.yml$/"
			],
			"matchStrings": ["FROM\\s+caddy:(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[\\w.-]+)?)"],
			"depNameTemplate": "caddy",
			"datasourceTemplate": "docker",
			"versioningTemplate": "docker"
		},
		{
			"customType": "regex",
			"description": "Update the caddy-fs-s3 Go module",
			"managerFilePatterns": [
				"/^\\.github\\/workflows\\/dev-deployments-server-image\\.yml$/"
			],
			"matchStrings": [
				"--with github\\.com/sagikazarmark/caddy-fs-s3@(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
			],
			"depNameTemplate": "github.com/sagikazarmark/caddy-fs-s3",
			"datasourceTemplate": "go",
			"versioningTemplate": "semver"
		}
	],
	"packageRules": [
		{
			"description": "Auto-merge updates to linters and formatters",
			"matchDepTypes": ["devDependencies"],
			"matchPackageNames": [
				"eslint",
				"@eslint/*",
				"eslint-*",
				"oxlint",
				"oxlint-*",
				"knip",
				"prettier",
				"prettier-*",
				"lint-staged",
				"svelte-check",
				"typescript-eslint"
			],
			"automerge": true,
			"prPriority": 10
		},
		{
			"description": "Auto-merge patch upgrades (E2E tests should validate that nothing catastrophic happens)",
			"matchUpdateTypes": ["patch"],
			"automerge": true,
			"prPriority": 5
		},
		{
			"description": "Do not auto-merge gradle or gradle-wrapper updates",
			"matchManagers": ["gradle", "gradle-wrapper"],
			"automerge": false,
			"prPriority": -1
		},
		{
			"description": "Group capacitor-related upgrades (for now)",
			"groupName": "Capacitor",
			"matchDepTypes": ["devDependencies"],
			"matchPackageNames": [
				"@capacitor/*",
				"@capgo/*",
				"@capacitor-community/*",
				"@capawesome/*"
			]
		}
	]
}
